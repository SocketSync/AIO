{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start FinWise web server",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\server.ps1",
                "-Port",
                "8080"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "finwise-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "endsPattern": "^READY: http://localhost:8080/$"
                }
            }
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild",
            "command": "cleanRebuild",
            "targets": [
                "[N/A - Select Kit]"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template clean rebuild task"
        }
    ]
}