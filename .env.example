# Production App Domain & Base URLs
APP_URL=https://www.finwise-app.xyz
FINWISE_PUBLIC_URL=https://www.finwise-app.xyz

# FinWise App Configuration Example
# Backend & Auth (Supabase Public Client Config - Anon Key Only)
# SECURITY NOTE: Never place SUPABASE_SERVICE_ROLE_KEY in frontend or public env files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Backend / Server-Side Environment Variables
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finwise_db
DB_USER=finwise_app
DB_PASS=your-db-password-here
SMTP_HOST=smtp.finwise-app.xyz
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@finwise-app.xyz

# Optional Third-Party Integrations
FIREBASE_API_KEY=your-firebase-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
